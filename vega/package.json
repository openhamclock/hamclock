{
  "name": "@openhamclock/hamclock-vega",
  "version": "4.33.0",
  "private": true,
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rm -rf buildinfo.json dist build CMakeUserPresets.json",
    "clean:all": "rm -rf node_modules buildinfo.json dist build CMakeUserPresets.json",
    "start": "react-native start",
    "build:release": "NODE_OPTIONS=\"--require ./node-compat.js\" react-native build-vega --build-type Release",
    "build:debug": "NODE_OPTIONS=\"--require ./node-compat.js\" react-native build-vega --build-type Debug",
    "build": "npm-run-all build:release"
  },
  "dependencies": {
    "@amazon-devices/react-native-kepler": "^4.0.0",
    "@amazon-devices/webview": "^4.0.0",
    "@react-native-async-storage/async-storage": "^1.24.0",
    "react": "19.2.0",
    "react-native": "0.83.0"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@amazon-devices/kepler-cli-platform": "^0",
    "@react-native-community/cli": "20.0.0",
    "@react-native/babel-preset": "0.83.0",
    "@react-native/metro-config": "0.83.0",
    "@types/react": "^19.2.0",
    "npm-run-all": "^4.1.5",
    "typescript": "5.8.3"
  },
  "kepler": {
    "projectType": "application",
    "appName": "HamClock",
    "targets": [
      "tv"
    ]
  },
  "overrides": {
    "react": "19.2.0",
    "react-native": "0.83.0"
  }
}
